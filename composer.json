{
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jethro-chms/jethro-sms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jethro-chms/jethro-url-shortener"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jethro-chms/smsmockserver"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jethro-chms/jethro-utils"
        }
    ],
    "require": {
        "cweagans/composer-patches": "^2.0",
        "drewm/mailchimp-api": "@stable",
        "jethro/jethro-sms": "^2.40",
        "jethro/jethro-url-shortener": "^0.2",
        "jethro/jethro-utils": "^1.0",
        "phpoffice/phpword": "v0.18.*",
        "swiftmailer/swiftmailer": "~5.4.12",
        "symfony/mailer": "^6.4"
    },
    "require-dev": {
        "jethro/smsmockserver": "^1.0.1"
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        },
        "platform-check": false,
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "patches": {
            "phpoffice/phpword": {
                "Fix PHP 8.1+ deprecations in Shared\\XMLWriter::writeAttribute (jethro-pmm #1206)": "patches/phpword-0.18.0-xmlwriter-writeattribute.patch"
            }
        }
    }
}
