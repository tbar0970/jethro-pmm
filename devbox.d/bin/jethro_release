#!/bin/bash -eu
#
# Build a jethro-$version.zip release distribution.
#
# The version is the first argument, else $JETHRO_VERSION with any trailing
# "-DEV" stripped (devbox.json sets e.g. JETHRO_VERSION=2.40.0-DEV).
#
# Usage:
#   devbox.d/bin/jethro_release                               release build, version from $JETHRO_VERSION
#   devbox.d/bin/jethro_release 2.40.0                        same, arg overrides env
#   devbox.d/bin/jethro_release --allow-untagged              test build from an untagged commit
#   devbox.d/bin/jethro_release 2.40-$(date +%Y%m%d) \
#     --allow-untagged                                        test build with a dated version
#   devbox.d/bin/jethro_release --with-dev                    include require-dev packages (smsmockserver)
#
# Steps:
#   1. refuse a DEV version, and require the commit to be a tag matching the
#      version (unless --allow-untagged)
#   2. compile the JS/CSS bundles and stamp include/version.txt (jethro_compile)
#   3. install the dependencies (vendor/) with Composer: production only, or
#      including require-dev with --with-dev
#   4. assemble the archive from the tracked commit (which honours
#      .gitattributes export-ignore), then overlay the freshly built vendor/
#      and compiled assets
#   5. write jethro-$version.zip plus a sha256 checksum
#
# `devbox.d/bin/jethro_docker build` passes --allow-untagged --with-dev: the
# image is built from the distribution and serves the dev-only SMS mock server
# (jethro/smsmockserver) at /smsmockserver.
#
# Works from a plain Git checkout and from a jj workspace/colocated repo; in
# the latter the released tree is the working-copy commit @.

version="${JETHRO_VERSION:-}"
version="${version%-DEV}"
allow_untagged=false
with_dev=false

# First positional argument overrides $JETHRO_VERSION.
if [[ $# -gt 0 && "$1" != -* ]]; then
	version="$1"
	shift
fi

while (($#)); do
	case "$1" in
		--allow-untagged)
			allow_untagged=true
			;;
		--with-dev)
			with_dev=true
			;;
		-*)
			echo >&2 "Unknown option: $1"
			exit 1
			;;
		*)
			echo >&2 "Unexpected argument: $1"
			exit 1
			;;
	esac
	shift
done

if [[ -z "$version" ]]; then
	echo >&2 "JETHRO_VERSION is not set"
	exit 1
fi
if [[ "$version" == *DEV* ]]; then
	echo >&2 "Refusing to build a DEV release (JETHRO_VERSION=$version)"
	exit 1
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_root"

# Locate the Git object store and the commit whose tree is released.
# A jj workspace (and a colocated jj repo) keeps the working-copy commit as @,
# which is not necessarily Git's HEAD, so resolve both through jj there.
git_dir=''
commit=''
if [[ -d .jj ]]; then
	command -v jj >/dev/null || { echo >&2 "jj is not on PATH"; exit 1; }
	# Make the working-copy commit's objects and refs visible to git.
	jj git export >/dev/null
	repo_dir="$(cd .jj && realpath "$(cat repo)")"
	git_dir="$(cd "$repo_dir/store" && realpath "$(cat git_target)")"
	commit="$(jj log -r @ --no-graph -T 'commit_id')"
else
	git_dir="$(git rev-parse --git-dir)" \
		|| { echo >&2 "Not a Git checkout or jj workspace"; exit 1; }
	commit=HEAD
fi
git_cmd() { git --git-dir="$git_dir" "$@"; }

# Release builds must run from a git tag matching the version; test builds
# (--allow-untagged) skip this.
if ! $allow_untagged; then
	tag="$(git_cmd describe --exact-match --tags "$commit" 2>/dev/null || true)"
	if [[ -z "$tag" ]]; then
		echo >&2 "Commit $commit is not tagged; release builds must run from a git tag"
		echo >&2 "(pass --allow-untagged to build a test archive without a tag)"
		exit 1
	fi
	if [[ "${tag#v}" != "$version" ]]; then
		echo >&2 "Tag '$tag' does not match JETHRO_VERSION '$version'"
		exit 1
	fi
fi

# 1. Compile the JS/CSS bundles and stamp include/version.txt.
"$script_dir/jethro_compile" "$version"

# 2. Dependencies. vendor/ is gitignored, so install it fresh.
if $with_dev; then
	composer install --optimize-autoloader --no-interaction --no-progress
else
	composer install --no-dev --optimize-autoloader --no-interaction --no-progress
fi

# 3. Assemble a clean tree from the tracked source, then overlay the build
#    output (vendor/ and the compiled assets) that git archive cannot see.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git_cmd archive --format=tar "$commit" | tar -x -C "$tmp"

cp -a vendor "$tmp/vendor"
cp include/version.txt "$tmp/include/version.txt"
if [[ -f "resources/css/jethro-$version.css" ]]; then
	cp "resources/css/jethro-$version.css" "$tmp/resources/css/"
fi
if [[ -f "resources/js/jethro-$version.js" ]]; then
	cp "resources/js/jethro-$version.js" "$tmp/resources/js/"
fi

# 4. Archive and checksum.
archive="jethro-$version.zip"
( cd "$tmp" && zip -qr "$repo_root/$archive" . )
( cd "$repo_root" && sha256sum "$archive" > "$archive.sha256" )

echo "Built $archive"
