# MySQL configuration file for Devbox MariaDB
#
# This file is read via --defaults-file, which means ONLY this config file
# is read (system configs in /etc/ are skipped).
#
# Runtime paths (datadir, socket, pid-file, basedir) are set by the wrapper
# script via environment variables and cannot be overridden here:
#
#   MYSQL_DATADIR  = --datadir   (default: .devbox/virtenv/mariadb/data)
#   MYSQL_UNIX_PORT = --socket   (default: .devbox/virtenv/mariadb/run/mysql.sock)
#   MYSQL_PID_FILE = --pid-file  (default: .devbox/virtenv/mariadb/run/mysql.pid)

# This my.cnf would work with MySQL too if this section was enabled:
# [mysqld]
# # https://github.com/tbar0970/jethro-pmm/pull/1510
# log_bin_trust_function_creators = ON
# # Turn off ONLY_FULL_GROUP_BY, per the README
# sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
# port = 3307

[mariadbd]

# Socket-only: the server does not listen on TCP at all (skip-networking).
# Every connection — Jethro's DB_DSN, the SMS mock server, the mariadb CLI
# wrappers, Docker — goes through the unix socket at $MYSQL_UNIX_PORT, so the
# plain 'jethro'@'localhost' grant works everywhere.
skip-networking

[client]
protocol = socket
user = jethro
password = jethro

[mysql]
# 'database' is a mysql-client-only option: mariadb-admin and mariadb-dump
# share [client] but have no --database option, so putting it there makes
# 'mariadb-admin ping' fail with "unknown variable 'database=jethro'" and
# mariadb_check then reports a false "mariadb is not running".
database = jethro

[client-admin]
# This section is used by mariadb-admin
protocol = socket
user = root
# If you change the root password ('mariadb-admin password'), set the new one here:
password = 
